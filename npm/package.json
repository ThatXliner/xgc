{
  "name": "@thatxliner/xgc",
  "description": "xliner’s GWS-CLI — dynamic Google Workspace commands from Discovery Service",
  "version": "0.22.5",
  "license": "Apache-2.0",
  "author": "xliner (fork), Justin Poehnelt (upstream)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThatXliner/xgc.git"
  },
  "homepage": "https://github.com/ThatXliner/xgc",
  "bugs": {
    "url": "https://github.com/ThatXliner/xgc/issues"
  },
  "bin": {
    "xgc": "run.js"
  },
  "scripts": {
    "postinstall": "node install.js"
  },
  "engines": {
    "node": ">=18"
  },
  "preferUnplugged": true,
  "keywords": [
    "cli",
    "google-workspace",
    "google",
    "google-api",
    "google-drive",
    "google-gmail",
    "google-sheets",
    "google-calendar",
    "google-docs",
    "google-chat",
    "google-admin",
    "gsuite",
    "discovery-api",
    "ai-agent",
    "agent-skills",
    "automation",
    "oauth2",
    "rust"
  ],
  "publishConfig": {
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "supportedPlatforms": {
    "aarch64-apple-darwin": {
      "artifact": "xgc-aarch64-apple-darwin.tar.gz",
      "binary": "xgc"
    },
    "x86_64-apple-darwin": {
      "artifact": "xgc-x86_64-apple-darwin.tar.gz",
      "binary": "xgc"
    },
    "aarch64-unknown-linux-gnu": {
      "artifact": "xgc-aarch64-unknown-linux-gnu.tar.gz",
      "binary": "xgc"
    },
    "aarch64-unknown-linux-musl": {
      "artifact": "xgc-aarch64-unknown-linux-musl.tar.gz",
      "binary": "xgc"
    },
    "x86_64-unknown-linux-gnu": {
      "artifact": "xgc-x86_64-unknown-linux-gnu.tar.gz",
      "binary": "xgc"
    },
    "x86_64-unknown-linux-musl": {
      "artifact": "xgc-x86_64-unknown-linux-musl.tar.gz",
      "binary": "xgc"
    },
    "x86_64-pc-windows-msvc": {
      "artifact": "xgc-x86_64-pc-windows-msvc.zip",
      "binary": "xgc.exe"
    }
  }
}
