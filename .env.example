# xgc — xliner’s GWS-CLI
# Copy this file to .env and uncomment the variables you need.
# All variables are optional. See README.md for details.

# ── Authentication ────────────────────────────────────────────────
# Pre-obtained OAuth2 access token (highest priority; bypasses all credential loading)
# XGC_TOKEN=

# Path to OAuth credentials JSON (user or service account)
# XGC_CREDENTIALS_FILE=

# Named auth profile (default: default; overridden by --profile)
# XGC_PROFILE=default

# Keyring backend: keyring (default) or file
# XGC_KEYRING_BACKEND=keyring

# ── OAuth Client ──────────────────────────────────────────────────
# OAuth client ID and secret (alternative to saving client_secret.json)
# XGC_CLIENT_ID=
# XGC_CLIENT_SECRET=

# ── Configuration ─────────────────────────────────────────────────
# Override the config directory (default: ~/.config/xgc)
# XGC_CONFIG_DIR=

# ── Model Armor (response sanitization) ──────────────────────────
# Default Model Armor template (overridden by --sanitize flag)
# XGC_SANITIZE_TEMPLATE=
# Sanitization mode: warn (default) or block
# XGC_SANITIZE_MODE=warn

# ── Helpers ───────────────────────────────────────────────────────
# GCP project ID fallback for gmail watch and events subscribe (overridden by --project)
# XGC_PROJECT_ID=

# ── Logging ───────────────────────────────────────────────────────
# Stderr log filter (for example: xgc=debug)
# XGC_LOG=
# Directory for JSON log files with daily rotation
# XGC_LOG_FILE=
